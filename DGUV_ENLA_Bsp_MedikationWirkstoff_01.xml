    <!--Bestandteil-->
    <itemCodeableConcept>
      <!-- Kodierung des Bestandteils als ASK-Code -->
      <coding>
        <system value="http://fhir.de/CodeSystem/ask"/>
        <code value="01212"/>
        <display value="Paracetamol"/>

  <!-- Therapeutisch nicht wirksamer 3. Bestandteil -->
  <ingredient>
    <!-- Bestandteil -->
    <itemCodeableConcept>
      <!-- Beschreibung des Bestandteils als Freitext -->
      <text value="Mikrokristalline Cellulose (Füllmittel)"/>
    </itemCodeableConcept>

    <!-- Kennzeichnung als im Sinne der Therapie NICHT wirksamer Bestandteil -->
    <isActive value="false"/>
  </ingredient>

  <!-- Angaben zur Charge -->
  <batch>
    <!-- Chargennummer als Freitext -->
    <lotNumber value="DE-MU-2026-11"/>
  </batch>
</Medication>
    <coding>
      <system value="http://fhir.de/CodeSystem/bfarm/atc"/>
      <code value="N02BE01"/>
      <display value="Paracetamol"/>
    </coding>

    <!-- PZN / Pharmazentralnummer (Arzneimittel/Medikament) -->
    <!-- Eigentlich ist die Kodierung eines Arzneimittels/Medikaments bei Wirkstoff(!)beschreibung doch überflüssig. Entfernen ? Auch im Profil ? -->
    <coding>
      <system value="http://fhir.de/CodeSystem/ifa/pzn"/>
      <code value="01162549"/>
      <display value="PARACETAMOL 500 FAIR-MED"/>
    </coding>

    <!-- Beschreibung der Wirkstoffe als Freitext -->
    <text value="Hier steht eine freitextliche Beschreibung, Auflistung der Wirkstoffe."/>
  </code>

  <!-- Status der Medikation -->
  <status value="active"/>

  <!--Abgabeform-->
  <form>
    <coding>
      <system value="http://standardterms.edqm.eu"/>
      <code value="10220000"/>
      <display value="Coated tablet"/>
    </coding>
  </form>

  <!--Menge-->
  <amount>
    <numerator>
      <value value="4.13"/>
      <unit value="Gramm"/>
      <system value="http://unitsofmeasure.org"/>
      <code value="g"/>
    </numerator>
    <denominator>
      <value value="0.75"/>
      <unit value="kilogram"/>
      <system value="http://unitsofmeasure.org"/>
      <code value="kg"/>
    </denominator>
  </amount>

  <!-- Informationen zu Bestandteilen (Wirkstoffe) -->
  <!-- Therapeutisch wirksamer 1. Bestandteil -->
  <ingredient>


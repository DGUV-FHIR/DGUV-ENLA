<Medication xmlns="http://hl7.org/fhir">
  <!--Meta-Daten-->
  <id value="8947dca1-69fd-4184-a55f-8f7f32b0a914" />
  <meta>
      <profile value="http://fhir.dguv.de/ENLA/Medication/DGUV-ENLA-PR-MedikationWirkstoff" />
  </meta>

  <!-- Narrativ -->
  <text>
    <status value="generated"/>
    <div xmlns="http://www.w3.org/1999/xhtml">
      <h1>Hier finden Sie das Beispiel der Beschreibung einer Medikation als Wirkstoff für eine verunfallte Person.</h1>
    </div>
  </text>

  <!-- Dokumentation der Medikation -->
  <!-- Medikament in codierter und Freitextform -->
  <code>

 Datum: 12.11.2026

 Die vorliegende Beispiel-Datei "DGUV_ENLA_Bsp_VersichertenVerhaeltnis_03.xml" dient der Validierung
 folgenden Szenarios:
 
 P: Ausgehend von Standardfall:
    KEINE Familienversicherung (false) UND kein Mitgliedsname: Nicht-Auslösung dguv-famvers-2
-->

<Coverage xmlns="http://hl7.org/fhir">
    <!-- Meta-Daten -->
    <id value="75c6d854-876e-4b9d-8ea9-327a46c9c50f" />
    <meta>
        <profile value="http://fhir.dguv.de/ENLA/Coverage/DGUV-ENLA-PR-VersichertenVerhaeltnis" />
    </meta>

    <!-- Narrativ -->
    <text>
        <status value="generated"/>
        <div xmlns="http://www.w3.org/1999/xhtml">
        <h1>Hier finden Sie das Beispiel eines Versichertenverhältnisses der verunfallten Person (KEINE Familienversicherung und kein Mitgliedsname).</h1>
        </div>
    </text>

    <!-- Angaben zum Versichertenverhältnis -->
    <extension  url="http://fhir.dguv.de/Basis/Extension/DGUV-Basis-EX-Familienversicherung">
            <!-- Verunfallte Person über Familienversicherung versichert ? -->
            <extension url="Familienversichert">
                <valueBoolean value="false" />
            </extension>
            <!-- Name des Mitglieds in der Familienversicherung: nicht vorhanden -->
    </extension>

    <!-- Status des Versichertenverhältnisses -->    
    <status value="active"/>

    <!-- Referenz auf verunfallte, versorgte Person -->
    <beneficiary>
        <reference value="http://fhir.dguv.de/ENLA/Patient/482bb42d-a37b-45f7-8893-0abe669bd8ba" />
    </beneficiary>

    <!-- Referenz auf Kostenträger / Unfallversicherungsträger -->
    <payor>
        <reference value="http://fhir.dguv.de/ENLA/Organization/180f219f-97a8-486d-99d9-ed631fe4fc60"/>
    </payor>
</Coverage>
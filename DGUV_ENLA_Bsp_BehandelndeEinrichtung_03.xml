<Organization xmlns="http://hl7.org/fhir">
    <!--Meta-Daten-->
    <id value="BehandelndeEinrichtung-234" />
    <meta>
        <profile value="http://fhir.dguv.de/ENLA/Organization/DGUV-ENLA-PR-BehandelndeEinrichtung" />
    </meta>

    <!--Narrativ-->
    <text>
        <status value="generated"/>
        <div xmlns="http://www.w3.org/1999/xhtml">
            <h1>Hier finden Sie ein Beispiel der BehandelndeEinrichtung einer verunfallten Person entsprechend des VersichertePerson-Profils der DGUV</h1>
        </div>
    </text>    

    <!--Identifikatoren der behandelnden Einrichtung-->
    <!--Institutionskennzeichen (IKNR) - Slice "Institutionskennzeichen"-->
    <identifier>
        <type>
            <coding>
                <system value="http://terminology.hl7.org/CodeSystem/v2-0203" />
                <code value="XX" />
                <display value="Organization identifier" />
            </coding>
        </type>
        <system value="http://fhir.de/sid/arge-ik/iknr" />
        <value value="260530784" />
    </identifier>

    <!-- Typ der behandelnden Einrichtung -->
    <!-- Hier: Behandelnde Fachabteilung -->
    <type>  
        <coding>
            <system value="http://fhir.de/CodeSystem/dkgev/Fachabteilungsschluessel" />
            <version value="1.5.4" />
            <code value="0100" />
            <display value="Innere Medizin" />
        </coding>
    </type>

    <!-- Name der behandelnden Einrichtung -->
    <name value="Unfallkrankenhaus Frechen"/>

    <!-- Kontaktdaten -->
    <!-- Hier: Telefonnummer -->
    <telecom>
        <system value="phone"/>
        <value value="+1-1234565789"/>
    </telecom>

    <!--Adresse der behandelnden Einrichtung (Straßenanschrift) -->
    <address>
        <!-- Stadt-/Ortsteil (Erweiterung an Address) -->
        <extension url="http://hl7.org/fhir/StructureDefinition/iso21090-ADXP-precinct">
          <valueString value="Zentrale Altstadt"/>
        </extension>

        <!-- Kennzeichnung als Straßenadresse -->
        <type value="both"/>

        <!--Adresszeile mit strukturierten Erweiterungen (Straße, Hausnummer, optionaler Zusatz) -->
        <line value="Genesungsweg 4">
            <!-- Straßenname -->
            <extension url="http://hl7.org/fhir/StructureDefinition/iso21090-ADXP-streetName">
                <valueString value="Genesungsweg"/>
            </extension>

            <!-- Hausnummer -->
            <extension url="http://hl7.org/fhir/StructureDefinition/iso21090-ADXP-houseNumber">
                <valueString value="4"/>
            </extension>
    
            <!--Adresszusatz (optional) -->
            <extension url="http://hl7.org/fhir/StructureDefinition/iso21090-ADXP-additionalLocator">
              <valueString value="Haus B"/>
            </extension>
        </line>

        <!-- KEINE Extra-Adresszeile für Stadt-/Ortsteil -->

        <!-- Stadt/Ort -->
        <city value="Frechen"/>

        <!-- Postleitzahl -->
        <postalCode value="50226"/>

        <!-- Staat -->
        <country value="DE"/>
    </address>

</Organization>
 <Condition xmlns="http://hl7.org/fhir">
    <id value="DGUV-ENLA-PR-DiagnoseFreitext"/>
    <meta>
        <profile value="http://fhir.dguv.de/ENLA/Condition/DGUV-ENLA-PR-DiagnoseFreitext"/>
    </meta>

    <text>
        <status value="generated"/>
        <div xmlns="http://www.w3.org/1999/xhtml">
            <h1>Hier finden Sie ein Beispiel eines DiagnoseFreitextes.</h1>
        </div>
    </text>

    <!-- AO Klassifikation-->
    <extension url="http://fhir.dguv.de/Basis/Extension/DGUV-Basis-EX-Frakturklassifikation">
        <extension url="Fraktur">
            <valueBoolean value="false"/> 
        </extension>
        <extension url="AO-Klassifikation">
            <valueString value="12A 12B 12C"/>
        </extension>
    </extension>

    <!-- Freitextliche Diagnose -->
    <code>
        <text value="Hier steht der Freitext!"/>
    </code>

    <!-- Referenz auf die VersichertePerson -->
    <subject>
        <reference value="Patient/T37501234"/>
    </subject>
</Condition>